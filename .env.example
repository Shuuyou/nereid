# ============ SecAgent 环境配置模板 ============
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，切勿提交。

# ---- LLM (主用) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---- LLM (备选 fallback，可留空) ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- 资产测绘 (奇安信 Hunter) ----
HUNTER_API_KEY=

# ---- 数据源可选凭据 (不填也能跑，限流更紧) ----
NVD_API_KEY=
GITHUB_TOKEN=
FOFA_EMAIL=
FOFA_KEY=
SHODAN_API_KEY=

# ---- 基础设施 ----
POSTGRES_USER=secagent
POSTGRES_PASSWORD=secagent_dev_pwd
POSTGRES_DB=secagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6380
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secagent_neo4j_pwd

# ---- 运行参数 ----
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
POLL_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
